  version           VarChar(20)? @default("v1.0")
  es_vigente        Boolean? @default(true)
  id_plano_anterior Int?
  estado_aprobacion VarChar(50)? @default("Aprobado Obra")
  fecha_vobo        DateString?
  formato_peso      VarChar(50)?
  archivo_url       VarChar(1000)?
  emitido_por       VarChar(150)?
  created_at        DateTime? @default(now())
  @@map("obra_planos")
}

model obra_documentos_actas {
  id              Int    @id @default(autoincrement())
  id_centro_costo Int
  centroCosto     CentroCostos @relation(fields: [id_centro_costo], references: [id], onDelete: Cascade)
  titulo          VarChar(255)
  subtitulo       VarChar(1000)?
  categoria       VarChar(100)
  nro_registro    VarChar(100)?
  fecha_emision   DateString?
  vigencia_texto  VarChar(100)?
  estado          VarChar(50)? @default("Validado")
  archivo_url     VarChar(1000)?
  created_at      DateTime? @default(now())
  @@map("obra_documentos_actas")
}

model obra_incidencias_rfi {
  id                            Int    @id @default(autoincrement())
  id_centro_costo               Int
  centroCosto                   CentroCostos @relation(fields: [id_centro_costo], references: [id], onDelete: Cascade)
  codigo_incidencia             VarChar(50)
  titulo                        VarChar(255)
  descripcion                   VarChar(1000)
  prioridad                     VarChar(50)? @default("MEDIA")
  responsable                   VarChar(150)?
  accion_solicitada_o_ejecutada VarChar(1000)?
  plazo_resolucion              VarChar(100)?
  estado                        VarChar(50)? @default("PENDIENTE")
  fecha_reporte                 DateTime? @default(now())
  fecha_resolucion              DateTime?
  @@map("obra_incidencias_rfi")
}

model ppto_Plantillas {
  id              Int      @id @default(autoincrement())
  IdPlantilla     VarChar(255)? @unique
  Nombre          VarChar(255)
  Descripcion     VarChar(500)?
  Activo          Boolean  @default(true)
  FechaCreacion   DateTime @default(now())
  
  fases           ppto_Plantillas_Fases[]
  @@map("ppto_Plantillas")
}

model ppto_Plantillas_Fases {
  id              Int      @id @default(autoincrement())
  IdPlantillaFase VarChar(255)? @unique
  IdPlantilla     VarChar(255)
  IdpptoFase      VarChar(255)
  Orden           Int      @default(0)
  
  plantilla       ppto_Plantillas @relation(fields: [IdPlantilla], references: [IdPlantilla])
  categorias      ppto_Plantillas_Categorias[]
  @@map("ppto_Plantillas_Fases")
}

model ppto_Plantillas_Categorias {
  id                      Int      @id @default(autoincrement())
  IdPlantillaFase         VarChar(255)
  IdpptoFaseCategoria     VarChar(255)
  CostoReferencial        Decimal?
  
  fasePlantilla           ppto_Plantillas_Fases @relation(fields: [IdPlantillaFase], references: [IdPlantillaFase])
  @@map("ppto_Plantillas_Categorias")
}
