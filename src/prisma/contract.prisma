model Incidencia {
  id                   Int             @id @default(autoincrement())

  // I.- Datos del Registrador
  promotor             VarChar(255)?
  docRegistrador       VarChar(255)?
  cargoRegistrador     VarChar(255)?

  // II.- Datos del Solicitante
  solicitante          VarChar(255)?
  docSolicitante       VarChar(255)?
  telefonoSolicitante  VarChar(255)?
  domicilioSolicitante VarChar(255)?

  // III.- Datos de la Incidencia
  fechaIncidencia      Timestamptz(3)?
  horaIncidencia       VarChar(10)?
  origenIncidencia     VarChar(255)?
  viaOrigen            VarChar(255)?
  cuadra               VarChar(255)?
  urbanizacion         VarChar(255)?
  sectorVecinal        VarChar(255)?
  tipificacion         VarChar(255)?
  direccionExacta      VarChar(255)?
  incidencia           String?
  prioridadCategoria   VarChar(255)?
  latitud              VarChar(50)?
  longitud             VarChar(50)?

  // IV.- Atención de la Incidencia
  gerenciaAsignada     VarChar(255)?
  representante        VarChar(255)?
  estado               VarChar(50)     @default("PENDIENTE")
  accionPrevia         String?
  accionTomada         String?
  aprobacion           VarChar(255)?
  documentoGestrad     VarChar(255)?

  // Metadatos
  fechaInicio          DateTime        @default(now())
  fechaFin             DateTime?
  fechaCreacion        DateTime        @default(now())
  @@map("incidencia")
}

