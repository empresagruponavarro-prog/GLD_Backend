// use prisma-next
enum tipo_item {
  PRODUCTO
  SERVICIO
}

// ---- Control de almacen (plan 04) ----
enum clase_inventario {
  CONSUMIBLE
  EQUIPO_RETORNABLE
  MERCADERIA_CLIENTE
}

enum estado_operativo {
  NORMAL
  NO_OPERATIVO
  DESCONTINUADO
}

enum naturaleza_documento {
  INGRESO
  SALIDA
  TRANSFERENCIA
}

enum motivo_movimiento {
  INVENTARIO_INICIAL
  COMPRA
  DEVOLUCION
  INGRESO_CLIENTE
  AJUSTE_POSITIVO
  CONSUMO
  VENTA
  BAJA
  AJUSTE_NEGATIVO
  TRANSFERENCIA
}

enum estado_documento {
  REGISTRADO
  ANULADO
}

enum estado_prestamo {
  ABIERTO
  PARCIAL
  CERRADO
  ANULADO
}

enum condicion_retorno {
  OPERATIVO
  NO_OPERATIVO
  CON_FALTANTES
  DANADO
}

// ============================================================
// Maestros modernos
// ============================================================
model tipo_categoria {
  id         Int         @id @default(autoincrement())
  codigo     String      @unique
  nombre     String
  estado     Boolean     @default(true)
  categorias categoria[]
  @@map("tipo_categoria")
}

model categoria {
  id                Int            @id @default(autoincrement())
  codigo            String         @unique
  id_tipo_categoria Int
  descripcion       String?
  estado            Boolean        @default(true)
  tipo_categoria    tipo_categoria @relation(fields:[id_tipo_categoria], references:[id])
  productos         producto[]
  ordenCompras      OrdenCompra[]
  @@map("categoria")
}

model centro_costos_principal {
  id                     Int          @id @default(autoincrement())
  centro_costo_principal VarChar(255) @unique
  descripcion            String
  estado                 VarChar(50)  @default("ABIERTO")
  id_empresa             Int?
  empresa                Empresas?    @relation(fields: [id_empresa], references: [id_empresa], onDelete: SetNull)
  pptoFases              ppto_Fases[]

  @@map("centro_costos_principal")
}

model unidad_medida {
  id                   Int                          @id @default(autoincrement())
  codigo               String                       @unique
  descripcion          String
  simbolo              String?
  estado               Boolean                      @default(true)
  equivalenciasOrigen  unidad_medida_equivalencia[] @relation("origen")
  equivalenciasDestino unidad_medida_equivalencia[] @relation("destino")
  @@map("unidad_medida")
}

model unidad_medida_equivalencia {
  id                 Int           @id @default(autoincrement())
  id_uni_med_origen  Int
  id_uni_med_destino Int
  factor_conversion  Decimal
  estado             Boolean       @default(true)
  unidadOrigen       unidad_medida @relation("origen", fields:[id_uni_med_origen], references:[id])
  unidadDestino      unidad_medida @relation("destino", fields:[id_uni_med_destino], references:[id])

  @@unique([id_uni_med_origen, id_uni_med_destino])
  @@map("unidad_medida_equivalencia")
}

model producto {
  id                 Int                    @id @default(autoincrement())
  codigo             String                 @unique
  descripcion        String
  id_categoria       Int
  id_unidad_medida   Int
  tipo_producto      tipo_item              @default(PRODUCTO)
  stock              Decimal                @default("0")
  comentarios        String?
  imagen_url         String?
  estado             Boolean                @default(true)
  id_familia         Int?
  clase_inventario   clase_inventario       @default(CONSUMIBLE)
  uso_principal      String?
  stock_minimo       Decimal                @default("0")
  stock_objetivo     Decimal                @default("0")
  estado_operativo   estado_operativo       @default(NORMAL)
  id_almacen_default Int?
  costo_promedio     Decimal                @default("0")
  categoria          categoria              @relation(fields:[id_categoria], references:[id])
  unidad_medida      unidad_medida          @relation(fields:[id_unidad_medida], references:[id])
  familia            familia_almacen?       @relation(fields:[id_familia], references:[id])
  almacenDefault     almacen?               @relation("ProductoAlmacenDefault", fields:[id_almacen_default], references:[id])
  alternativas       producto_alternativa[] @relation("ProductoAlternativas")
  alternativaDe      producto_alternativa[] @relation("ProductoEsAlternativa")
  stocksAlmacen      stock_almacen[]
  documentoDetalles  almacen_documento_detalle[]
  kardex             almacen_kardex[]
  prestamoDetalles   almacen_prestamo_detalle[]
  @@map("producto")
}

model familia_almacen {
  id                 Int        @id @default(autoincrement())
  prefijo            VarChar(3) @unique
  nombre             String
  ultimo_correlativo Int        @default(0)
  estado             Boolean    @default(true)
  productos          producto[]
  @@map("familia_almacen")
}

model almacen {
  id                Int                 @id @default(autoincrement())
  codigo            VarChar(20)         @unique
  nombre            String
  id_empresa        Int?
  estado            Boolean             @default(true)
  empresa           Empresas?           @relation("AlmacenEmpresa", fields:[id_empresa], references:[id_empresa], onDelete: SetNull)
  productosDefault  producto[]          @relation("ProductoAlmacenDefault")
  stocks            stock_almacen[]
  documentosOrigen  almacen_documento[] @relation("DocumentoAlmacen")
  documentosDestino almacen_documento[] @relation("DocumentoAlmacenDestino")
  kardex            almacen_kardex[]
  prestamos         almacen_prestamo[]
  @@map("almacen")
}

model producto_alternativa {
  id                      Int      @id @default(autoincrement())
  id_producto             Int
  id_producto_alternativo Int
  prioridad               Int
  producto                producto @relation("ProductoAlternativas", fields:[id_producto], references:[id], onDelete: Cascade)
  alternativo             producto @relation("ProductoEsAlternativa", fields:[id_producto_alternativo], references:[id], onDelete: Cascade)
  @@unique([id_producto, id_producto_alternativo])
  @@unique([id_producto, prioridad])
  @@map("producto_alternativa")
}

model stock_almacen {
  id                    Int      @id @default(autoincrement())
  id_producto           Int
  id_almacen            Int
  cantidad              Decimal  @default("0")
  cantidad_prestada     Decimal  @default("0")
  cantidad_no_operativa Decimal  @default("0")
  updated_at            DateTime @default(now())
  producto              producto @relation(fields:[id_producto], references:[id])
  almacen               almacen  @relation(fields:[id_almacen], references:[id])
  @@unique([id_producto, id_almacen])
  @@map("stock_almacen")
}

model almacen_correlativo {
  serie  VarChar(10) @id
  ultimo Int         @default(0)
  @@map("almacen_correlativo")
}

model almacen_documento {
  id                   Int                  @id @default(autoincrement())
  numero               VarChar(20)          @unique
  naturaleza           naturaleza_documento
  motivo               motivo_movimiento
  fecha                DateString
  id_almacen           Int
  id_almacen_destino   Int?
  documento_referencia VarChar(50)?
  id_proveedor         Int?
  id_centro_costo      Int?
  id_recibido_por      Int?
  id_solicitado_por    Int?
  id_entregado_a       Int?
  motivo_trabajo       String?
  observaciones        String?
  estado               estado_documento     @default(REGISTRADO)
  id_documento_anula   Int?
  created_at           DateTime             @default(now())
  almacen              almacen              @relation("DocumentoAlmacen", fields:[id_almacen], references:[id])
  almacenDestino       almacen?             @relation("DocumentoAlmacenDestino", fields:[id_almacen_destino], references:[id])
  proveedor            Anexos?              @relation("DocumentoProveedor", fields:[id_proveedor], references:[id])
  recibidoPor          Anexos?              @relation("DocumentoRecibidoPor", fields:[id_recibido_por], references:[id])
  solicitadoPor        Anexos?              @relation("DocumentoSolicitadoPor", fields:[id_solicitado_por], references:[id])
  entregadoA           Anexos?              @relation("DocumentoEntregadoA", fields:[id_entregado_a], references:[id])
  centroCosto          CentroCostos?        @relation("DocumentoCentroCosto", fields:[id_centro_costo], references:[id])
  detalles             almacen_documento_detalle[]
  kardex               almacen_kardex[]
  @@index([naturaleza, fecha])
  @@map("almacen_documento")
}

model almacen_documento_detalle {
  id             Int               @id @default(autoincrement())
  id_documento   Int
  id_producto    Int
  cantidad       Decimal
  costo_unitario Decimal?
  observaciones  String?
  documento      almacen_documento @relation(fields:[id_documento], references:[id], onDelete: Cascade)
  producto       producto          @relation(fields:[id_producto], references:[id])
  kardex         almacen_kardex[]
  @@index([id_documento])
  @@map("almacen_documento_detalle")
}

model almacen_kardex {
  id                   Int                       @id @default(autoincrement())
  fecha                DateString
  created_at           DateTime                  @default(now())
  id_producto          Int
  id_almacen           Int
  id_documento         Int
  id_documento_detalle Int
  motivo               motivo_movimiento
  cantidad_entrada     Decimal                   @default("0")
  cantidad_salida      Decimal                   @default("0")
  costo_unitario       Decimal                   @default("0")
  costo_total          Decimal                   @default("0")
  saldo_almacen        Decimal                   @default("0")
  saldo_total          Decimal                   @default("0")
  costo_promedio       Decimal                   @default("0")
  producto             producto                  @relation(fields:[id_producto], references:[id])
  almacen              almacen                   @relation(fields:[id_almacen], references:[id])
  documento            almacen_documento         @relation(fields:[id_documento], references:[id])
  detalle              almacen_documento_detalle @relation(fields:[id_documento_detalle], references:[id])
  @@index([id_producto, id_almacen, fecha])
  @@index([id_documento])
  @@map("almacen_kardex")
}

model almacen_prestamo {
  id                     Int             @id @default(autoincrement())
  numero                 VarChar(20)     @unique
  fecha_prestamo         DateString
  id_almacen             Int
  id_centro_costo        Int?
  id_responsable         Int
  documento_referencia   VarChar(50)?
  dias_autorizados       Int
  fecha_prevista_retorno DateString
  estado                 estado_prestamo @default(ABIERTO)
  observaciones          String?
  created_at             DateTime        @default(now())
  almacen                almacen         @relation(fields:[id_almacen], references:[id])
  centroCosto            CentroCostos?   @relation("PrestamoCentroCosto", fields:[id_centro_costo], references:[id])
  responsable            Anexos          @relation("PrestamoResponsable", fields:[id_responsable], references:[id])
  detalles               almacen_prestamo_detalle[]
  @@map("almacen_prestamo")
}

model almacen_prestamo_detalle {
  id                Int              @id @default(autoincrement())
  id_prestamo       Int
  id_producto       Int
  cantidad          Decimal
  cantidad_devuelta Decimal          @default("0")
  prestamo          almacen_prestamo @relation(fields:[id_prestamo], references:[id], onDelete: Cascade)
  producto          producto         @relation(fields:[id_producto], references:[id])
  retornos          almacen_prestamo_retorno[]
  @@index([id_prestamo])
  @@map("almacen_prestamo_detalle")
}

model almacen_prestamo_retorno {
  id                  Int                      @id @default(autoincrement())
  id_prestamo_detalle Int
  fecha_retorno       DateString
  cantidad            Decimal
  condicion           condicion_retorno
  observaciones       String?
  created_at          DateTime                 @default(now())
  detalle             almacen_prestamo_detalle @relation(fields:[id_prestamo_detalle], references:[id], onDelete: Cascade)
  @@map("almacen_prestamo_retorno")
}

// ============================================================
// Legacy modernizado (tipos reales + PK uniforme)
// ============================================================
model AlmacenMovimientoDetalle {
  id                   Int           @id @default(autoincrement())
  CodMovimientoDetalle VarChar(255)?
  CodMovimiento        VarChar(255)?
  ProductoCodigo       VarChar(255)?
  Comportamiento       VarChar(255)?
  Cantidad             Decimal?
  @@map("almacenMovimientoDetalle")
}

model AlmacenMovimientos {
  id                    Int             @id @default(autoincrement())
  CodMovimiento         VarChar(255)?
  id_empresa             Int?
  empresa               Empresas?       @relation(fields: [id_empresa], references: [id_empresa], onDelete: SetNull)
  TipoCosto             VarChar(255)?
  CodigoAnexo           VarChar(255)?
  CodCentroCtoPrincipal VarChar(255)?
  CodCentroCto          VarChar(255)?
  id_centro_costo       Int?
  centroCosto           CentroCostos? @relation(fields: [id_centro_costo], references: [id], onDelete: SetNull)
  CodAlmacen            VarChar(255)?
  CodTipoMov            VarChar(255)?
  Comportamiento        VarChar(255)?
  Fecha                 Timestamptz(3)?
  @@map("almacenMovimientos")
}

model AlmacenTipoMovimiento {
  id             Int           @id @default(autoincrement())
  CodTipoMov     VarChar(255)?
  TipoMovimiento VarChar(255)?
  Comportamiento VarChar(255)?
  @@map("almacenTipoMovimiento")
}

model Almacenes {
  id         Int           @id @default(autoincrement())
  CodAlmacen VarChar(255)?
  id_empresa  Int?
  empresa    Empresas? @relation(fields: [id_empresa], references: [id_empresa], onDelete: SetNull)
  Almacen    VarChar(255)?
  @@map("almacenes")
}

model Anexo_Especialidad {
  id                 Int           @id @default(autoincrement())
  TipoAnexo          VarChar(255)?
  Anexo_Especialidad VarChar(255)? @map("Anexo Especialidad")
  anexos             Anexos[]
  @@map("anexo_Especialidad")
}

model Anexo_TipoDocIDE {
  id                  Int           @id @default(autoincrement())
  TipoAnexo           VarChar(255)?
  Anexo_Documento_IDE VarChar(255)?
  anexos              Anexos[]
  @@map("anexo_TipoDocIDE")
}

enum TipoAnexo {
  @@type("pg/text@1")
  Proveedor = "Proveedor"
  Cliente = "Cliente"
  Trabajador = "Trabajador"
}

model Anexos {
  id                  Int           @id @default(autoincrement())
  tipoAnexo           TipoAnexo?
  AnexoEspecialidadId Int?
  especialidad        Anexo_Especialidad? @relation(fields: [AnexoEspecialidadId], references: [id], onDelete: SetNull)
  AnexoTipoDocIdeId   Int?
  tipoDocIdentidad    Anexo_TipoDocIDE? @relation(fields: [AnexoTipoDocIdeId], references: [id], onDelete: SetNull)
  NumeroDocIde        VarChar(255)?
  Anexo               VarChar(255)?
  NombreComercial     VarChar(255)?
  Direccion           VarChar(255)?
  Contacto            VarChar(255)?
  Telefono            VarChar(255)?
  Correo              VarChar(255)?
  estado              Boolean       @default(true)
  ordenCompras        OrdenCompra[]
  docProveedor        almacen_documento[] @relation("DocumentoProveedor")
  docRecibidoPor      almacen_documento[] @relation("DocumentoRecibidoPor")
  docSolicitadoPor    almacen_documento[] @relation("DocumentoSolicitadoPor")
  docEntregadoA       almacen_documento[] @relation("DocumentoEntregadoA")
  prestamosResponsable almacen_prestamo[] @relation("PrestamoResponsable")
  @@map("anexos")
}

model Bancos {
  id      Int           @id @default(autoincrement())
  IdBanco VarChar(255)?
  Banco   VarChar(255)?
  @@map("bancos")
}

model CajaEgresosRetail {
  id                    Int             @id @default(autoincrement())
  IdMov                 VarChar(255)?
  id_empresa             Int?
  empresa               Empresas?       @relation(fields: [id_empresa], references: [id_empresa], onDelete: SetNull)
  TipoCosto             VarChar(255)?
  CodCentroCtoPrincipal VarChar(255)?
  CodCentroCto          VarChar(255)?
  id_centro_costo       Int?
  centroCosto           CentroCostos? @relation(fields: [id_centro_costo], references: [id], onDelete: SetNull)
  IdPresupuesto         VarChar(255)?
  IdpptoFase            VarChar(255)?
  IdpptoFaseCategoria   VarChar(255)?
  TipoAnexo             VarChar(255)?
  CodMotivo             VarChar(255)?
  CodigoAnexo           VarChar(255)?
  Fecha                 Timestamptz(3)?
  IdCtaCajaBanco        VarChar(255)?
  MedioPago             VarChar(255)?
  NumOperacion          VarChar(255)?
  CodDocSunat           VarChar(255)?
  DocSunat              VarChar(255)?
  Concepto              String?
  CodCentroCtoTerminado VarChar(255)?
  CategoriaCodigo       VarChar(255)?
  MonedaId              VarChar(255)?
  TotalSinDocumento     Decimal?
  TotalPagoDocumentos   Decimal?
  Monto_Total           Decimal?        @map("Monto Total")
  VoucherDeposito       VarChar(255)?
  Ajuste                VarChar(255)?
  @@map("cajaEgresosRetail")
}

model CajaIngresos {
  id                    Int             @id @default(autoincrement())
  IdMov                 VarChar(255)?
  id_empresa             Int?
  empresa               Empresas?       @relation(fields: [id_empresa], references: [id_empresa], onDelete: SetNull)
  CodCentroCtoPrincipal VarChar(255)?
  CodCentroCto          VarChar(255)?
  id_centro_costo       Int?
  centroCosto           CentroCostos? @relation(fields: [id_centro_costo], references: [id], onDelete: SetNull)
  IdPresupuesto         VarChar(255)?
  TipoAnexo             VarChar(255)?
  CodMotivo             VarChar(255)?
  CodigoAnexo           VarChar(255)?
  Fecha                 Timestamptz(3)?
  IdCtaCajaBanco        VarChar(255)?
  MedioPago             VarChar(255)?
  NumOperacion          VarChar(255)?
  Concepto              String?
  TotalSinDocumento     Decimal?
  TotalPagoDocumentos   Decimal?
  Monto_Total           Decimal?        @map("Monto Total")
  VoucherDeposito       VarChar(255)?
  @@map("cajaIngresos")
}

model CajaIngresos_DocVenta {
  id            Int           @id @default(autoincrement())
  IdMovDocVenta VarChar(255)?
  IdMov         VarChar(255)?
  CodigoAnexo   VarChar(255)?
  CodDocSunat   VarChar(255)?
  NumDocumento  VarChar(255)?
  IdDocVenta    VarChar(255)?
  MontoPagado   Decimal?
  @@map("cajaIngresos_DocVenta")
}

model CajaMotivos {
  id             Int           @id @default(autoincrement())
  CodMotivo      VarChar(255)?
  TipoMotivo     VarChar(255)?
  Motivo         VarChar(255)?
  Comportamiento VarChar(255)?
  Resultado      VarChar(255)?
  @@map("cajaMotivos")
}

model CentroCostos {
  id                            Int                     @id @default(autoincrement())
  periodo                       Int?
  cod_cliente                   VarChar(255)?
  id_centro_costos_principal    Int?
  principal                     centro_costos_principal? @relation(fields: [id_centro_costos_principal], references: [id], onDelete: SetNull)
  centro_costo                  VarChar(255)?
  estado                        VarChar(50)?
  fecha_inicio                  DateString?
  fecha_fin_prog                DateString?
  fecha_fin_real                DateString?
  presupuesto_estado            VarChar(50)?
  presupuesto_costo_directo     Decimal?
  presupuesto_gastos_generales  Decimal?
  presupuesto_viaticos          Decimal?
  presupuesto_monto             Decimal?
  oc_file                       VarChar(255)?
  id_empresa                    Int?
  empresa                       Empresas?               @relation("CentroCostosEmpresa", fields: [id_empresa], references: [id_empresa], onDelete: SetNull)
  id_anexo                      Int?
  anexo                         Anexos?                 @relation("CentroCostosAnexo", fields: [id_anexo], references: [id], onDelete: SetNull)

  almacenMovimientos     AlmacenMovimientos[]
  cajaEgresosRetail      CajaEgresosRetail[]
  cajaIngresos           CajaIngresos[]
  contratacionesPPTOMeta Contrataciones_PPTOMeta[]
  docCompras             DocCompra[]
  docCompraDetalles      DocCompraDetalle[]
  docVentas              DocVenta[]
  docVentaDetalles       DocVentaDetalle[]
  egresosAnticiposOC     Egresos_AnticiposOC[]
  ordenCompras           OrdenCompra[]
  pptoDetalleFases       ppto_DetalleFases[]
  pptoDetalleFasesCates  ppto_DetalleFasesCate[]
  pptoPrincipales        ppto_Principal[]
  almacenDocumentos      almacen_documento[] @relation("DocumentoCentroCosto")
  almacenPrestamos       almacen_prestamo[] @relation("PrestamoCentroCosto")

  @@index([id_centro_costos_principal])
  @@map("CentroCostos")
}

model Contrataciones {
  id                    Int           @id @default(autoincrement())
  Codcontratacion       VarChar(255)?
  id_empresa             Int?
  empresa               Empresas?     @relation(fields: [id_empresa], references: [id_empresa], onDelete: SetNull)
  periodo               Int?
  CodCliente            VarChar(255)?
  CodCentroCtoPrincipal VarChar(255)?
  CentroCosto           VarChar(255)?
  CodProveedor          VarChar(255)?
  Proveedor             VarChar(255)?
  CategoriaCodigo       VarChar(255)?
  Categoria             VarChar(255)?
  TIPOCATE              VarChar(255)?
  TipoContratacion      VarChar(255)?
  Numero                VarChar(255)?
  Concepto              String?
  PptoMetaTotal         Decimal?
  PresupuestoMonto      Decimal?
  PresupuestoIGV        Decimal?
  PresupuestoTotal      Decimal?
  MaterialesManual      Decimal?
  DsctoPostVenta        Decimal?
  DsctoPersonalCasa     Decimal?
  DsctoIntervencion     Decimal?
  DsctoFacturacion      Decimal?
  EstadoObra            VarChar(50)?
  LiquidacionPDF        VarChar(255)?
  ContratoPDF           VarChar(255)?
  PresupuestoFile       VarChar(255)?
  @@map("contrataciones")
}

model Contrataciones_PPTOMeta {
  id                      Int             @id @default(autoincrement())
  Codcontratacionpptometa VarChar(255)?
  Codcontratacion         VarChar(255)?
  id_empresa               Int?
  empresa                 Empresas?      @relation(fields: [id_empresa], references: [id_empresa], onDelete: SetNull)
  CodCentroCtoPrincipal   VarChar(255)?
  CodCentroCto            VarChar(255)?
  id_centro_costo         Int?
  centroCosto             CentroCostos? @relation(fields: [id_centro_costo], references: [id], onDelete: SetNull)
  CodProveedor            VarChar(255)?
  Fecha                   Timestamptz(3)?
  Concepto                String?
  Monto                   Decimal?
  File                    VarChar(255)?
  @@map("contrataciones_PPTOMeta")
}

model Contrataciones_PostVenta {
  id                       Int             @id @default(autoincrement())
  CodcontratacionPostVenta VarChar(255)?
  Codcontratacion          VarChar(255)?
  id_empresa                Int?
  empresa                  Empresas?       @relation(fields: [id_empresa], references: [id_empresa], onDelete: SetNull)
  CodCentroCtoPrincipal    VarChar(255)?
  CentroCosto              VarChar(255)?
  CodProveedor             VarChar(255)?
  Proveedor                VarChar(255)?
  Fecha                    Timestamptz(3)?
  Concepto                 String?
  Monto                    Decimal?
  File                     VarChar(255)?
  @@map("contrataciones_PostVenta")
}

model CuentasCajaBancos {
  id                Int             @id @default(autoincrement())
  IdCtaCajaBanco    VarChar(255)?
  id_empresa         Int?
  empresa           Empresas?       @relation(fields: [id_empresa], references: [id_empresa], onDelete: SetNull)
  Tipo              VarChar(255)?
  IdBanco           VarChar(255)?
  NroCuenta         VarChar(255)?
  CCICuenta         VarChar(255)?
