        "name": "unidad_medida"
      }
    },
    "precheck": [],
    "execute": [
      {
        "description": "seed unidades itemizado",
        "sql": "INSERT INTO \"public\".\"unidad_medida\" (codigo, descripcion, simbolo) SELECT v.codigo, v.descripcion, v.simbolo FROM (VALUES ('GLB', 'Global', 'glb'), ('PTO', 'Punto', 'pto'), ('M3', 'Metro cubico', 'm3'), ('MES', 'Mes', 'mes')) AS v(codigo, descripcion, simbolo) WHERE NOT EXISTS (SELECT 1 FROM \"public\".\"unidad_medida\" u WHERE lower(u.simbolo) = lower(v.simbolo) OR u.codigo = v.codigo)",
        "params": []
      }
    ],
    "postcheck": []
  },
