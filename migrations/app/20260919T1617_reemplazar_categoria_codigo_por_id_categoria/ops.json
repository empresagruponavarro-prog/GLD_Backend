  {
    "id": "data.ordenCompra.backfill-id-categoria",
    "label": "Backfill ordenCompra.id_categoria",
    "summary": "Copia ordenCompra.id_categoria desde categoria.id usando CategoriaCodigo = categoria.codigo",
    "operationClass": "data",
    "target": {
      "id": "postgres",
      "details": {
        "schema": "public",
        "objectType": "column",
        "name": "id_categoria",
        "table": "ordenCompra"
      }
    },
    "precheck": [
      {
        "description": "ensure rows pending id_categoria backfill",
        "sql": "SELECT EXISTS (   SELECT 1 AS \"one\" FROM \"public\".\"ordenCompra\" oc   JOIN \"public\".\"categoria\" c ON c.codigo = oc.\"CategoriaCodigo\"   WHERE oc.id_categoria IS DISTINCT FROM c.id ) AS \"result\"",
        "params": []
      }
    ],
    "execute": [
      {
        "description": "copy categoria id into ordenCompra.id_categoria",
        "sql": "UPDATE \"public\".\"ordenCompra\" oc SET id_categoria = c.id FROM \"public\".\"categoria\" c WHERE c.codigo = oc.\"CategoriaCodigo\"   AND oc.id_categoria IS DISTINCT FROM c.id",
        "params": []
      }
    ],
    "postcheck": [
      {
        "description": "verify no rows pending id_categoria backfill",
        "sql": "SELECT NOT EXISTS (   SELECT 1 AS \"one\" FROM \"public\".\"ordenCompra\" oc   JOIN \"public\".\"categoria\" c ON c.codigo = oc.\"CategoriaCodigo\"   WHERE oc.id_categoria IS DISTINCT FROM c.id ) AS \"result\"",
        "params": []
      }
    ]
  },
