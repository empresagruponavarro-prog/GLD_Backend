# Copy this file to `.env` and replace the placeholder with your real connection string.
# Connection string for PostgreSQL.
# Requires PostgreSQL >= 15.

DATABASE_URL="postgresql://user:password@localhost:5432/mydb"

# Secreto para firmar los JWT (HS256). OBLIGATORIO: minimo 32 caracteres; el
# servidor no arranca sin el. Genere uno aleatorio con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Permitir subida y almacenamiento de archivos localmente en el disco del servidor (default: false).
# Si es false, los archivos se gestionan unicamente mediante enlaces en la nube (Google Drive, OneDrive, etc.).
ALLOW_LOCAL_STORAGE=false
