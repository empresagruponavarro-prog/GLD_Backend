# Copy this file to `.env` and replace the placeholder with your real connection string.
# Connection string for PostgreSQL.
# Requires PostgreSQL >= 15.

DATABASE_URL="postgresql://user:password@localhost:5432/mydb"

# Secreto para firmar los JWT (HS256). OBLIGATORIO: minimo 32 caracteres; el
# servidor no arranca sin el. Genere uno aleatorio con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Permitir subida y almacenamiento de archivos localmente en el disco del servidor (default: false).
# Si es false, los archivos se gestionan unicamente mediante enlaces en la nube (Google Drive, OneDrive, etc.).
ALLOW_LOCAL_STORAGE=false

# Permisos por modulo en la API (plan 05, D8): "auditoria" (por defecto si falta o es invalido)
# registra en logs/permisos-auditoria.jsonl lo que se negaria SIN bloquear; "estricto" responde 403.
# El grupo Administracion (empresas, usuarios, roles) se aplica siempre en estricto.
# Revise GET /administration/permisos/auditoria con el equipo antes de pasar a estricto.
PERMISOS_MODO=auditoria

# Paginas web que pueden llamar a la API desde el navegador (CORS), separadas por comas.
# Si falta: http://192.168.18.231 (frontend del servidor) y http://localhost:4200 (desarrollo).
CORS_ORIGENES=http://192.168.18.231,http://localhost:4200
